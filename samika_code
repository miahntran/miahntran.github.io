<!DOCTYPE html> <html lang="en"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title>Discover Your Personality</title> <style> *{box-sizing:border-box} :root{--bg:#f4f1eb;--card:#fff;--text:#1d1d1f;--muted:#747474;--line:#dedbd4;--accent:#252525} body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,Arial,sans-serif} .wrap{max-width:850px;margin:auto;padding:28px 18px 60px} .card{background:var(--card);border-radius:24px;padding:34px;box-shadow:0 12px 40px rgba(0,0,0,.07)} h1{font-size:clamp(34px,6vw,54px);margin:0 0 12px;letter-spacing:-1.5px} h2{font-size:clamp(25px,4vw,34px);margin:0 0 16px} p{line-height:1.6}.muted{color:var(--muted)} .hidden{display:none!important} .top{display:flex;justify-content:space-between;gap:16px;align-items:center;color:var(--muted);font-size:14px} .progress{height:8px;background:#e8e5df;border-radius:99px;overflow:hidden;margin:18px 0 36px} .progress>div{height:100%;width:0;background:var(--accent);transition:width .3s} .prompt{font-size:14px;color:var(--muted);margin-bottom:8px} .question{font-size:28px;font-weight:750;line-height:1.25;margin-bottom:24px} .answers{display:grid;gap:12px} .answer{width:100%;text-align:left;background:#fff;border:2px solid var(--line);border-radius:15px;padding:18px;font-size:16px;cursor:pointer;color:var(--text);transition:.15s} .answer:hover{border-color:#999;background:#fafafa} .scale{display:grid;grid-template-columns:repeat(5,1fr);gap:9px} .scale button{text-align:center;min-height:82px} .scale small{display:block;color:var(--muted);margin-top:6px} button.primary{background:#222;color:#fff;border:0;border-radius:13px;padding:15px 22px;font-size:16px;cursor:pointer} .intro ul{line-height:2} .result-type{font-size:clamp(44px,9vw,76px);font-weight:800;letter-spacing:-2px;margin:4px 0} .badge{display:inline-block;border:1px solid var(--line);border-radius:99px;padding:7px 12px;font-size:13px;color:var(--muted)} .spectrum{margin:28px 0} .shead{display:flex;justify-content:space-between;font-size:14px;font-weight:700;margin-bottom:9px} .sbar{height:13px;background:#e5e2dc;border-radius:99px;position:relative} .dot{position:absolute;top:50%;width:22px;height:22px;border-radius:50%;background:#222;border:4px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.2);transform:translate(-50%,-50%)} .center{text-align:center}.small{font-size:13px;color:var(--muted)} @media(max-width:620px){.card{padding:24px}.scale{grid-template-columns:1fr}.scale button{min-height:auto;text-align:left}.question{font-size:23px}} </style> </head> <body> <div class="wrap"> <section id="start" class="card intro"> <span class="badge">30 questions · 3 spectrums · 8 archetypes</span> <h1>Discover Your Personality</h1> <p class="muted">Explore how you naturally socialize, approach change, and make decisions.</p> <ul> <li><b>Social Orientation:</b> Introverted ↔ Extraverted</li> <li><b>Mindset:</b> Grounded ↔ Trailblazing</li> <li><b>Decision Style:</b> Analytical ↔ Empathetic</li> </ul> <p>There are no right or wrong answers. Choose the answer that feels most like you.</p> <button class="primary" onclick="startQuiz()">Start Quiz</button> </section> <section id="quiz" class="card hidden"> <div class="top"><span id="qnum"></span><span id="kind"></span></div> <div class="progress"><div id="bar"></div></div> <div id="prompt" class="prompt"></div> <div id="qtext" class="question"></div> <div id="answers" class="answers"></div> </section> <section id="result" class="card hidden"> <span class="badge">Your result</span> <div id="rtype" class="result-type"></div> <p id="rdesc" class="muted"></p> <div id="spectrums"></div> <button class="primary" onclick="restart()">Take the Quiz Again</button> </section> </div> <script> const questions = [ {t:"agreement",s:"social",d:"right",q:"I feel energized after spending time with large groups of people."}, {t:"agreement",s:"social",d:"right",q:"I enjoy meeting new people whenever I get the chance."}, {t:"agreement",s:"social",d:"left",q:"I usually think through my ideas before sharing them."}, {t:"agreement",s:"social",d:"left",q:"I feel energized after spending time with myself."}, {t:"agreement",s:"mindset",d:"right",q:"I enjoy experimenting with different ways of doing things over traditional methods."}, {t:"agreement",s:"mindset",d:"right",q:"I often question why things are done in a certain way."}, {t:"agreement",s:"mindset",d:"left",q:"If a method has worked for a long time, I think it's best not to change it."}, {t:"agreement",s:"mindset",d:"left",q:"I prefer following proven methods over taking unnecessary risks."}, {t:"agreement",s:"decision",d:"left",q:"When making important decisions, I rely on facts."}, {t:"agreement",s:"decision",d:"left",q:"Even during emotional situations, I try to stay objective."}, {t:"agreement",s:"decision",d:"right",q:"I naturally think of how my decisions will affect other people."}, {t:"agreement",s:"decision",d:"right",q:"I believe maintaining relationships is more important than winning an argument."}, {t:"forced",s:"social",q:"On a free afternoon, you'd rather...",o:[ ["Go on a walk, watch a movie, listen to music.","left"],["Go out with friends, play a team sport, go to a concert.","right"]]}, {t:"forced",s:"social",q:"During a group discussion, you're more likely to...",o:[ ["Listen first and share your thoughts after you've had time to think.","left"],["Jump into the conversation and think out loud.","right"]]}, {t:"forced",s:"social",q:"When you meet someone new, you usually...",o:[ ["Have a conversation and move on.","left"],["Introduce yourself and try to connect.","right"]]}, {t:"forced",s:"mindset",q:"When solving a problem, you'd rather...",o:[ ["Improve a solution that's already been proven to work.","left"],["Come up with an entirely new solution.","right"]]}, {t:"forced",s:"mindset",q:"When learning something new, you prefer to...",o:[ ["Follow the instructions step by step.","left"],["Experiment and figure things out on your own.","right"]]}, {t:"forced",s:"mindset",q:"When someone says, \"This is how we've always done it,\" you usually...",o:[ ["Trust that there's probably a good reason.","left"],["Wonder if there's a better way.","right"]]}, {t:"forced",s:"decision",q:"When making an important decision, you're more likely to...",o:[ ["Choose the option that considers facts and data.","left"],["Choose the option that considers morals and feelings.","right"]]}, {t:"forced",s:"decision",q:"When a friend comes to you with a problem, your first instinct is to...",o:[ ["Help them figure out a solution.","left"],["Help them feel understood.","right"]]}, {t:"forced",s:"decision",q:"If two people are arguing, you're more likely to...",o:[ ["Focus on finding the fairest solution.","left"],["Focus on helping both people feel heard.","right"]]}, {t:"scenario",s:"social",q:"You walk into a party where you only know one person. What do you do first?",o:[ ["Stay close to the person you know.","left"],["Introduce yourself to new people.","right"]]}, {t:"scenario",s:"social",q:"Your class/work team is assigned a group project.",o:[ ["Work on your assigned section independently, then report back to your group.","left"],["Constantly collaborate with the group, getting ongoing feedback as you work.","right"]]}, {t:"scenario",s:"mindset",q:"Your team has a method for projects that has worked in the past. What would you do?",o:[ ["Keep using it so that nothing goes wrong.","left"],["Suggest trying a different method to see if there's something that works better.","right"]]}, {t:"scenario",s:"mindset",q:"You're planning out a build for an engineering competition and you want to make a design that wins. What is your initial plan?",o:[ ["Use a proven design with small improvements.","left"],["Try an entirely original concept.","right"]]}, {t:"scenario",s:"decision",q:"Two friends are in an argument and they are coming to you to see your opinion. What do you do first?",o:[ ["Figure out who has the stronger argument.","left"],["Help both people feel understood.","right"]]}, {t:"scenario",s:"decision",q:"A teammate misses a crucial deadline and comes to you for help. What do you do first?",o:[ ["Focus on how to solve the problem quickly.","left"],["Ask what's going on before deciding what to do.","right"]]}, {t:"ranking",s:"social",q:"Which of these are you MOST likely and LEAST likely to do?",o:[ ["Start a conversation with someone you've never met.","right"],["Spend an afternoon reading, gaming, or working on a hobby by yourself.","left"],["Organize a group activity with friends.","right"],["Have a long one-on-one conversation with someone close.","left"]]}, {t:"ranking",s:"mindset",q:"Which of these are you MOST likely and LEAST likely to do?",o:[ ["Try a completely new way to solve a problem.","right"],["Improve an existing solution.","left"],["Follow a proven method because you know it works.","left"],["Question a rule that doesn't seem useful.","right"]]}, {t:"ranking",s:"decision",q:"Which of these are you MOST likely and LEAST likely to do?",o:[ ["Solve a problem using logic and evidence.","left"],["Make sure everyone feels heard before making a decision.","right"],["Find the most efficient solution.","left"],["Consider how your choice affects other people.","right"]]} ]; const types={ "LLL":["Guardian","You are dependable, thoughtful, and grounded. You value stability, responsibility, and doing things well."], "LLR":["Idealist","You are thoughtful and people-focused, valuing stability while making choices through empathy and personal values."], "LRL":["Designer","You are an independent problem-solver who combines a trailblazing mindset with analytical thinking."], "LRR":["Builder","You are practical, creative, and adaptable. You enjoy turning ideas into something real while considering people."], "RLL":["Coordinator","You naturally bring structure to groups, combining social energy with practical and analytical decision-making."], "RLR":["Connector","You bring people together and value collaboration, relationships, and dependable approaches."], "RRL":["Innovator","You are a bold idea generator who enjoys challenging assumptions, experimenting, and solving problems analytically."], "RRR":["Explorer","You are energetic, adaptable, and adventurous. You enjoy new experiences and tend to respond creatively and empathetically."] }; let i=0, scores={social:0,mindset:0,decision:0}, answered={social:0,mindset:0,decision:0}; function startQuiz(){ document.getElementById("start").classList.add("hidden"); document.getElementById("quiz").classList.remove("hidden"); i=0;scores={social:0,mindset:0,decision:0};answered={social:0,mindset:0,decision:0}; show(); } function show(){ const x=questions[i], a=document.getElementById("answers"); document.getElementById("qnum").textContent=`Question ${i+1} of ${questions.length}`; document.getElementById("kind").textContent=x.t==="agreement"?"Agreement Scale":x.t==="forced"?"Forced Choice":x.t==="scenario"?"Scenario":"Most / Least Likely"; document.getElementById("bar").style.width=((i)/questions.length*100)+"%"; document.getElementById("qtext").textContent=x.q; document.getElementById("prompt").textContent=x.t==="agreement"?"How much do you agree?":x.t==="ranking"?"Choose one MOST likely first.":""; a.innerHTML=""; if(x.t==="agreement"){ const vals=[["Strongly Disagree",-2],["Disagree",-1],["Neutral",0],["Agree",1],["Strongly Agree",2]]; const box=document.createElement("div");box.className="scale"; vals.forEach(([label,v])=>{let b=document.createElement("button");b.className="answer";b.innerHTML=`${label}`;b.onclick=()=>{score(x,v);next()};box.appendChild(b)}); a.appendChild(box); }else if(x.t==="ranking"){ x.o.forEach((z,k)=>{let b=document.createElement("button");b.className="answer";b.textContent=z[0];b.onclick=()=>{scoreDir(x,z[1],2);least(x,k)};a.appendChild(b)}); }else{ x.o.forEach(z=>{let b=document.createElement("button");b.className="answer";b.textContent=z[0];b.onclick=()=>{scoreDir(x,z[1],2);next()};a.appendChild(b)}); } } function score(x,v){scores[x.s]+=x.d==="right"?v:-v;answered[x.s]+=2} function scoreDir(x,d,pts){scores[x.s]+=(d==="right"?pts:-pts);answered[x.s]+=pts} function least(x,most){ const a=document.getElementById("answers");a.innerHTML=""; document.getElementById("prompt").textContent="Now choose the option you are LEAST likely to do."; x.o.forEach((z,k)=>{if(k===most)return;let b=document.createElement("button");b.className="answer";b.textContent=z[0];b.onclick=()=>{scoreDir(x,z[1],-2);next()};a.appendChild(b)}); } function next(){i++;if(i>=questions.length)result();else show()} function pct(s){return Math.max(0,Math.min(100,50+s*5))} function result(){ document.getElementById("quiz").classList.add("hidden");document.getElementById("result").classList.remove("hidden"); const ps={social:pct(scores.social),mindset:pct(scores.mindset),decision:pct(scores.decision)}; const key=(ps.social>=50?"R":"L")+(ps.mindset>=50?"R":"L")+(ps.decision>=50?"R":"L"); const r=types[key]; document.getElementById("rtype").textContent=r[0];document.getElementById("rdesc").textContent=r[1]; const data=[ ["Social Orientation","Introverted","Extraverted",ps.social], ["Mindset","Grounded","Trailblazing",ps.mindset], ["Decision Style","Analytical","Empathetic",ps.decision] ]; document.getElementById("spectrums").innerHTML=data.map(d=>`<div class="spectrum"><div class="shead"><span>${d[1]}</span><span>${d[2]}</span></div><div class="sbar"><div class="dot" style="left:${d[3]}%"></div></div><div class="center small">${d[0]} · ${Math.round(d[3])}% toward ${d[3]>=50?d[2]:d[1]}</div></div>`).join(""); } function restart(){document.getElementById("result").classList.add("hidden");document.getElementById("start").classList.remove("hidden")} </script> </body> </html> 
